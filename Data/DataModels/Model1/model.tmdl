/// =============================================================================
/// Model1 — Minimal Star Schema
///
/// Demonstrates the smallest useful Power BI model: one fact table, a
/// conformed set of dimensions, and a dedicated date table.
///
/// What this model is for
/// ----------------------
/// This is a *structural* example. The date table is a calculated table and
/// needs no data source, so it works as-is. The dimension and fact tables
/// declare their columns, relationships, and measures, but their M
/// partitions point at placeholder CSV paths that must be replaced before the
/// model will load. See README.md.
///
/// Conventions demonstrated
/// ------------------------
///   - Star schema: one fact table, dimensions joined many-to-one.
///   - Single-direction filtering on every relationship.
///   - A dedicated date table, marked as a date table, rather than reusing a
///     date column from the fact table.
///   - Surrogate integer keys rather than natural keys.
///   - Foreign key columns hidden in the dimension.
///   - Measures rather than calculated columns for anything aggregatable.
/// =============================================================================

model Model1
    culture: en-US
    defaultPowerBIDataSourceVersion: powerBI_V3
    sourceQueryCulture: en-US

    /// Refusing data loads for the whole model makes it safe to ship an
    /// example model to a team without anyone loading it by accident.
    annotation PBI_ProTooling = 1

    /// Descriptions on tables and columns show as tooltips in the field list,
    /// and are what the Best Practice Analyzer looks for.
    annotation __PBI_QueryGroups = 0
