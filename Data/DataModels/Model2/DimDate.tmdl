/// =============================================================================
/// DimDate
///
/// The same calculated date table as Model1, extended with a fiscal calendar.
///
/// It is duplicated rather than shared because each Power BI model is a
/// self-contained artefact. In a source-controlled setup the date table is
/// normally a single TMDL file that is copied into each model, or generated by
/// a script, so the two never drift apart silently.
/// =============================================================================

table 'DimDate'
    lineageTag: model2-dimdate
    dataCategory: Time
    description: "Contiguous date dimension with calendar and fiscal periods"

    annotation __PBI_LocalDateTable = true

    column 'Date'
        dataType: dateTime
        isKey: true
        isNullable: false
        formatString: Short Date
        summarizeBy: none
        description: "Calendar date, one row per day with no gaps"
        lineageTag: model2-date-col-001
        annotation SummarizationSetBy = Automatic

    column 'Year'
        dataType: int64
        isNullable: false
        formatString: 0
        summarizeBy: none
        lineageTag: model2-date-col-002

    column 'Year-Month'
        dataType: string
        isNullable: false
        sortByColumn: 'Year-Month Number'
        summarizeBy: none
        lineageTag: model2-date-col-003

    column 'Year-Month Number'
        dataType: int64
        isNullable: false
        isHidden: true
        summarizeBy: none
        lineageTag: model2-date-col-004

    column 'Quarter'
        dataType: string
        isNullable: false
        sortByColumn: 'Quarter Number'
        summarizeBy: none
        lineageTag: model2-date-col-005

    column 'Quarter Number'
        dataType: int64
        isNullable: false
        summarizeBy: none
        lineageTag: model2-date-col-006

    column 'Month'
        dataType: string
        isNullable: false
        sortByColumn: 'Month Number'
        summarizeBy: none
        lineageTag: model2-date-col-007

    column 'Month Number'
        dataType: int64
        isNullable: false
        summarizeBy: none
        lineageTag: model2-date-col-008

    /// --- Fiscal columns ---------------------------------------------
    ///
    /// Modelled on a July fiscal year start. Change FiscalStartMonth to match
    /// your organisation, and keep it consistent with the calculated table
    /// definition below.

    column 'Fiscal Year'
        dataType: int64
        isNullable: false
        formatString: 0
        summarizeBy: none
        description: "Fiscal year label, where a July start makes the following calendar year the fiscal year"
        lineageTag: model2-date-col-030

    column 'Fiscal Quarter'
        dataType: string
        isNullable: false
        sortByColumn: 'Fiscal Quarter Number'
        summarizeBy: none
        lineageTag: model2-date-col-031

    column 'Fiscal Quarter Number'
        dataType: int64
        isNullable: false
        isHidden: true
        summarizeBy: none
        lineageTag: model2-date-col-032

    column 'Is Current Month'
        dataType: boolean
        isNullable: false
        summarizeBy: none
        lineageTag: model2-date-col-020

    /// --- Date selection table ---------------------------------------
    ///
    /// A single-column table listing the roles the date dimension plays. A
    /// slicer on this table lets the user choose "Order Date" or "Ship Date",
    /// and a USERELATIONSHIP measure switches relationship accordingly. This
    /// is the accepted alternative to exposing inactive relationships
    /// directly, which report authors find confusing.

    measure 'Date Role' =
        SELECTEDVALUE('DimDateRole'[Role], "Order Date")
        formatString: @
        displayFolder: Date Selection
        description: "Currently selected date role"
        lineageTag: model2-mea-daterole

    hierarchy 'Calendar Hierarchy'
        lineageTag: model2-date-hier-001

        level 'Year'
            lineageTag: model2-date-hier-lvl-001
            column: 'Year'

        level 'Quarter'
            lineageTag: model2-date-hier-lvl-002
            column: 'Quarter'

        level 'Month'
            lineageTag: model2-date-hier-lvl-003
            column: 'Month'

        level 'Date'
            lineageTag: model2-date-hier-lvl-004
            column: 'Date'

    hierarchy 'Fiscal Hierarchy'
        lineageTag: model2-date-hier-002

        level 'Fiscal Year'
            lineageTag: model2-date-hier-lvl-010
            column: 'Fiscal Year'

        level 'Fiscal Quarter'
            lineageTag: model2-date-hier-lvl-011
            column: 'Fiscal Quarter'

        level 'Month'
            lineageTag: model2-date-hier-lvl-012
            column: 'Month'

    partition 'DimDate' = calculated
        mode: import
        source =
            VAR StartDate = DATE(2020, 1, 1)
            VAR EndDate = DATE(2030, 12, 31)
            VAR FiscalStartMonth = 7
            RETURN
            ADDCOLUMNS(
                CALENDAR(StartDate, EndDate),
                "Year", YEAR([Date]),
                "Year-Month", FORMAT([Date], "YYYY-MM"),
                "Year-Month Number", YEAR([Date]) * 100 + MONTH([Date]),
                "Quarter", "Q" & QUARTER([Date]),
                "Quarter Number", QUARTER([Date]),
                "Month", FORMAT([Date], "MMMM"),
                "Month Number", MONTH([Date]),
                "Is Current Month",
                    YEAR([Date]) = YEAR(TODAY()) && MONTH([Date]) = MONTH(TODAY()),
                "Fiscal Year", IF(MONTH([Date]) >= FiscalStartMonth, YEAR([Date]) + 1, YEAR([Date])),
                "Fiscal Quarter Number",
                    CEILING(MOD(MONTH([Date]) - FiscalStartMonth, 12) / 3, 1) + 1,
                "Fiscal Quarter",
                    "FQ" & (CEILING(MOD(MONTH([Date]) - FiscalStartMonth, 12) / 3, 1) + 1)
            )

table 'DimDateRole'
    lineageTag: model2-dimdaterole
    description: "Single-column table listing the date roles, used to drive a role-playing date slicer"

    column 'Role'
        dataType: string
        isNullable: false
        summarizeBy: none
        description: "Which date relationship the user has selected"
        lineageTag: model2-role-col-001
        annotation SummarizationSetBy = Automatic

    partition 'DimDateRole' = calculated
        mode: import
        source =
            DATATABLE(
                "Role", STRING,
                {
                    {"Order Date"},
                    {"Ship Date"}
                }
            )
