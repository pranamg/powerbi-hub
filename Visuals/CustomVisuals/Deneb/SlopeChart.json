{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Slope Chart - Compare values between two time periods",
  "usermeta": {
    "deneb": {
      "build": "1.6.0",
      "metaVersion": 1,
      "provider": "vegaLite",
      "providerVersion": "5.14.1"
    },
    "information": {
      "name": "Slope Chart",
      "description": "Shows change in rank or value between two periods",
      "author": "PowerBI-Hub"
    },
    "dataset": [
      { "key": "__0__", "name": "Category", "description": "Item being compared", "type": "text", "kind": "column" },
      { "key": "__1__", "name": "Period1 Value", "description": "First period value", "type": "numeric", "kind": "measure" },
      { "key": "__2__", "name": "Period2 Value", "description": "Second period value", "type": "numeric", "kind": "measure" }
    ]
  },
  "data": { "name": "dataset" },
  "width": 300,
  "height": "container",
  "config": {
    "view": { "stroke": "transparent" },
    "axis": {
      "domain": false,
      "ticks": false,
      "labelPadding": 10
    }
  },
  "transform": [
    {
      "fold": ["__1__", "__2__"],
      "as": ["period", "value"]
    },
    {
      "calculate": "datum.period === '__1__' ? 'Period 1' : 'Period 2'",
      "as": "periodLabel"
    },
    {
      "calculate": "datum['__2__'] - datum['__1__']",
      "as": "change"
    },
    {
      "calculate": "datum.change >= 0 ? 'increase' : 'decrease'",
      "as": "direction"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2,
        "opacity": 0.7
      },
      "encoding": {
        "x": {
          "field": "periodLabel",
          "type": "ordinal",
          "axis": {
            "title": null,
            "labelFontSize": 14,
            "labelFontWeight": "bold"
          }
        },
        "y": {
          "field": "value",
          "type": "quantitative",
          "axis": { "title": null, "grid": false }
        },
        "color": {
          "field": "__0__",
          "type": "nominal",
          "legend": null
        },
        "strokeDash": {
          "condition": {
            "test": "datum.direction === 'decrease'",
            "value": [4, 4]
          },
          "value": []
        },
        "detail": {
          "field": "__0__"
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 100
      },
      "encoding": {
        "x": {
          "field": "periodLabel",
          "type": "ordinal"
        },
        "y": {
          "field": "value",
          "type": "quantitative"
        },
        "color": {
          "field": "__0__",
          "type": "nominal",
          "legend": null
        },
        "tooltip": [
          { "field": "__0__", "title": "Category" },
          { "field": "periodLabel", "title": "Period" },
          { "field": "value", "title": "Value", "format": ",.0f" }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -15,
        "fontSize": 11
      },
      "transform": [
        { "filter": "datum.periodLabel === 'Period 1'" }
      ],
      "encoding": {
        "x": {
          "field": "periodLabel",
          "type": "ordinal"
        },
        "y": {
          "field": "value",
          "type": "quantitative"
        },
        "text": {
          "field": "__0__",
          "type": "nominal"
        },
        "color": {
          "field": "__0__",
          "type": "nominal",
          "legend": null
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 15,
        "fontSize": 11
      },
      "transform": [
        { "filter": "datum.periodLabel === 'Period 2'" }
      ],
      "encoding": {
        "x": {
          "field": "periodLabel",
          "type": "ordinal"
        },
        "y": {
          "field": "value",
          "type": "quantitative"
        },
        "text": {
          "field": "value",
          "type": "quantitative",
          "format": ",.0f"
        },
        "color": {
          "field": "__0__",
          "type": "nominal",
          "legend": null
        }
      }
    }
  ]
}
