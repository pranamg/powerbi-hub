// ============================================================================
// RAG STATUS ICONS (SVG)
// ============================================================================
// Purpose: Generate Red/Amber/Green status icons based on KPI values
// Usage: Set data category to "Image URL", add to table visual
// ============================================================================

// Basic Circle Icon - Color based on threshold
RAG Icon Circle = 
VAR Value = [KPI Value]
VAR Target = [KPI Target]
VAR Pct = DIVIDE(Value, Target)
VAR Color = 
    SWITCH(
        TRUE(),
        Pct >= 1, "%2328A745",      // Green (>=100%)
        Pct >= 0.8, "%23FFC107",    // Amber (80-99%)
        "%23DC3545"                  // Red (<80%)
    )
VAR SVG = 
    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='20' height='20'>" &
    "<circle cx='10' cy='10' r='8' fill='" & Color & "'/>" &
    "</svg>"
RETURN SVG


// Traffic Light Icon - Vertical 3-light display
RAG Traffic Light = 
VAR Value = [KPI Value]
VAR Target = [KPI Target]
VAR Pct = DIVIDE(Value, Target)
VAR Status = 
    SWITCH(
        TRUE(),
        Pct >= 1, "green",
        Pct >= 0.8, "amber",
        "red"
    )
VAR RedFill = IF(Status = "red", "%23DC3545", "%23E0E0E0")
VAR AmberFill = IF(Status = "amber", "%23FFC107", "%23E0E0E0")
VAR GreenFill = IF(Status = "green", "%2328A745", "%23E0E0E0")
VAR SVG = 
    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='16' height='40'>" &
    "<rect x='0' y='0' width='16' height='40' rx='3' fill='%23333'/>" &
    "<circle cx='8' cy='8' r='5' fill='" & RedFill & "'/>" &
    "<circle cx='8' cy='20' r='5' fill='" & AmberFill & "'/>" &
    "<circle cx='8' cy='32' r='5' fill='" & GreenFill & "'/>" &
    "</svg>"
RETURN SVG


// Arrow Icon - Up/Down/Flat indicator
RAG Arrow Icon = 
VAR CurrentValue = [Current Period Value]
VAR PriorValue = [Prior Period Value]
VAR Change = CurrentValue - PriorValue
VAR Color = 
    SWITCH(
        TRUE(),
        Change > 0, "%2328A745",     // Green for increase
        Change < 0, "%23DC3545",     // Red for decrease
        "%236C757D"                   // Gray for no change
    )
VAR Arrow = 
    SWITCH(
        TRUE(),
        Change > 0, "M10 5 L15 15 L12 15 L12 25 L8 25 L8 15 L5 15 Z",     // Up arrow
        Change < 0, "M10 25 L5 15 L8 15 L8 5 L12 5 L12 15 L15 15 Z",      // Down arrow
        "M5 12 L25 12 L25 18 L5 18 Z"                                      // Flat line
    )
VAR SVG = 
    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 30 30' width='24' height='24'>" &
    "<path d='" & Arrow & "' fill='" & Color & "'/>" &
    "</svg>"
RETURN SVG


// Checkmark/X Icon - Pass/Fail indicator
RAG Pass Fail Icon = 
VAR Passed = [Is Target Met]  // Boolean measure
VAR Color = IF(Passed, "%2328A745", "%23DC3545")
VAR Path = IF(
    Passed,
    "M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z",              // Checkmark
    "M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"  // X mark
)
VAR SVG = 
    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' width='24' height='24'>" &
    "<path d='" & Path & "' fill='" & Color & "'/>" &
    "</svg>"
RETURN SVG


// Star Rating Icon - 1-5 stars based on value
Star Rating = 
VAR Rating = ROUND([Average Rating], 0)  // Assumes 1-5 scale
VAR StarFilled = "%23FFD700"  // Gold
VAR StarEmpty = "%23E0E0E0"   // Gray
VAR Star1 = IF(Rating >= 1, StarFilled, StarEmpty)
VAR Star2 = IF(Rating >= 2, StarFilled, StarEmpty)
VAR Star3 = IF(Rating >= 3, StarFilled, StarEmpty)
VAR Star4 = IF(Rating >= 4, StarFilled, StarEmpty)
VAR Star5 = IF(Rating >= 5, StarFilled, StarEmpty)
VAR StarPath = "M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"
VAR SVG = 
    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 120 24' width='100' height='20'>" &
    "<g transform='translate(0,0)'><path d='" & StarPath & "' fill='" & Star1 & "'/></g>" &
    "<g transform='translate(24,0)'><path d='" & StarPath & "' fill='" & Star2 & "'/></g>" &
    "<g transform='translate(48,0)'><path d='" & StarPath & "' fill='" & Star3 & "'/></g>" &
    "<g transform='translate(72,0)'><path d='" & StarPath & "' fill='" & Star4 & "'/></g>" &
    "<g transform='translate(96,0)'><path d='" & StarPath & "' fill='" & Star5 & "'/></g>" &
    "</svg>"
RETURN SVG


// Badge with Text - Shows status as colored badge
Status Badge = 
VAR StatusText = [Status]  // Text like "Active", "Pending", "Closed"
VAR BGColor = 
    SWITCH(
        StatusText,
        "Active", "%2328A745",
        "Pending", "%23FFC107",
        "Closed", "%236C757D",
        "Overdue", "%23DC3545",
        "%23007BFF"  // Default blue
    )
VAR TextColor = 
    IF(StatusText = "Pending", "%23000000", "%23FFFFFF")
VAR TextWidth = LEN(StatusText) * 7 + 16
VAR SVG = 
    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='" & TextWidth & "' height='22'>" &
    "<rect x='0' y='0' width='" & TextWidth & "' height='22' rx='11' fill='" & BGColor & "'/>" &
    "<text x='" & (TextWidth / 2) & "' y='16' text-anchor='middle' font-family='Arial' font-size='12' fill='" & TextColor & "'>" & StatusText & "</text>" &
    "</svg>"
RETURN SVG
