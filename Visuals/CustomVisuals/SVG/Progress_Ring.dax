// ============================================================================
// PROGRESS RING (SVG)
// ============================================================================
// Purpose: Circular progress indicator showing percentage completion
// Usage: Set data category to "Image URL", add to table or card visual
// ============================================================================

// Basic Progress Ring
Progress Ring = 
VAR Pct = [Completion Percentage]  // Value between 0 and 1
VAR PctDisplay = FORMAT(Pct, "0%")
VAR Size = 60
VAR Radius = 25
VAR Circumference = 2 * PI() * Radius
VAR StrokeDashoffset = Circumference * (1 - Pct)
VAR TrackColor = "%23E0E0E0"
VAR ProgressColor = 
    SWITCH(
        TRUE(),
        Pct >= 0.9, "%2328A745",   // Green >= 90%
        Pct >= 0.7, "%23FFC107",   // Amber 70-89%
        "%23DC3545"                 // Red < 70%
    )
VAR SVG = 
    "data:image/svg+xml;utf8," &
    "<svg xmlns='http://www.w3.org/2000/svg' width='" & Size & "' height='" & Size & "' viewBox='0 0 " & Size & " " & Size & "'>" &
    
    // Background track
    "<circle cx='" & (Size/2) & "' cy='" & (Size/2) & "' r='" & Radius & "' " &
    "fill='none' stroke='" & TrackColor & "' stroke-width='6'/>" &
    
    // Progress arc
    "<circle cx='" & (Size/2) & "' cy='" & (Size/2) & "' r='" & Radius & "' " &
    "fill='none' stroke='" & ProgressColor & "' stroke-width='6' " &
    "stroke-linecap='round' " &
    "stroke-dasharray='" & Circumference & "' " &
    "stroke-dashoffset='" & StrokeDashoffset & "' " &
    "transform='rotate(-90 " & (Size/2) & " " & (Size/2) & ")'/>" &
    
    // Center text
    "<text x='" & (Size/2) & "' y='" & (Size/2 + 4) & "' text-anchor='middle' " &
    "font-family='Arial' font-size='12' font-weight='bold' fill='%23333'>" & PctDisplay & "</text>" &
    
    "</svg>"
RETURN SVG


// Progress Ring with Target Line
Progress Ring with Target = 
VAR Actual = [Actual Value]
VAR Target = [Target Value]
VAR Maximum = [Maximum Value]
VAR ActualPct = DIVIDE(Actual, Maximum)
VAR TargetPct = DIVIDE(Target, Maximum)

VAR Size = 70
VAR Radius = 28
VAR Circumference = 2 * PI() * Radius
VAR ActualOffset = Circumference * (1 - ActualPct)
VAR TargetAngle = (TargetPct * 360) - 90  // Rotate from top

VAR TrackColor = "%23E0E0E0"
VAR ActualColor = IF(Actual >= Target, "%2328A745", "%23DC3545")
VAR TargetColor = "%23333333"

VAR SVG = 
    "data:image/svg+xml;utf8," &
    "<svg xmlns='http://www.w3.org/2000/svg' width='" & Size & "' height='" & Size & "'>" &
    
    // Background track
    "<circle cx='" & (Size/2) & "' cy='" & (Size/2) & "' r='" & Radius & "' " &
    "fill='none' stroke='" & TrackColor & "' stroke-width='8'/>" &
    
    // Actual progress
    "<circle cx='" & (Size/2) & "' cy='" & (Size/2) & "' r='" & Radius & "' " &
    "fill='none' stroke='" & ActualColor & "' stroke-width='8' " &
    "stroke-linecap='round' " &
    "stroke-dasharray='" & Circumference & "' " &
    "stroke-dashoffset='" & ActualOffset & "' " &
    "transform='rotate(-90 " & (Size/2) & " " & (Size/2) & ")'/>" &
    
    // Target marker line
    "<line x1='" & (Size/2) & "' y1='" & (Size/2 - Radius + 4) & "' " &
    "x2='" & (Size/2) & "' y2='" & (Size/2 - Radius - 4) & "' " &
    "stroke='" & TargetColor & "' stroke-width='3' " &
    "transform='rotate(" & (TargetAngle + 90) & " " & (Size/2) & " " & (Size/2) & ")'/>" &
    
    // Center value
    "<text x='" & (Size/2) & "' y='" & (Size/2 + 4) & "' text-anchor='middle' " &
    "font-family='Arial' font-size='14' font-weight='bold' fill='%23333'>" & 
    FORMAT(Actual, "#,##0") & "</text>" &
    
    "</svg>"
RETURN SVG


// Semi-circle Gauge
Gauge Semi Circle = 
VAR Value = [KPI Value]
VAR MaxValue = [KPI Max]
VAR Pct = DIVIDE(Value, MaxValue)
VAR PctCapped = MIN(Pct, 1)  // Cap at 100%

VAR Width = 100
VAR Height = 60
VAR Radius = 40
VAR CenterX = Width / 2
VAR CenterY = 50

// Calculate arc end point (180 degree arc)
VAR Angle = PctCapped * 180
VAR EndX = CenterX + Radius * SIN(RADIANS(Angle))
VAR EndY = CenterY - Radius * COS(RADIANS(Angle))
VAR LargeArc = IF(Angle > 90, 1, 0)

VAR TrackColor = "%23E0E0E0"
VAR GaugeColor = 
    SWITCH(
        TRUE(),
        Pct >= 0.9, "%2328A745",
        Pct >= 0.7, "%23FFC107",
        "%23DC3545"
    )

VAR SVG = 
    "data:image/svg+xml;utf8," &
    "<svg xmlns='http://www.w3.org/2000/svg' width='" & Width & "' height='" & Height & "'>" &
    
    // Background arc
    "<path d='M " & (CenterX - Radius) & " " & CenterY & " A " & Radius & " " & Radius & " 0 0 1 " & (CenterX + Radius) & " " & CenterY & "' " &
    "fill='none' stroke='" & TrackColor & "' stroke-width='10' stroke-linecap='round'/>" &
    
    // Value arc
    "<path d='M " & (CenterX - Radius) & " " & CenterY & " A " & Radius & " " & Radius & " 0 " & LargeArc & " 1 " & EndX & " " & EndY & "' " &
    "fill='none' stroke='" & GaugeColor & "' stroke-width='10' stroke-linecap='round'/>" &
    
    // Value text
    "<text x='" & CenterX & "' y='" & (CenterY - 5) & "' text-anchor='middle' " &
    "font-family='Arial' font-size='16' font-weight='bold' fill='%23333'>" & 
    FORMAT(Value, "#,##0") & "</text>" &
    
    // Label
    "<text x='" & CenterX & "' y='" & (CenterY + 10) & "' text-anchor='middle' " &
    "font-family='Arial' font-size='10' fill='%23666'>of " & FORMAT(MaxValue, "#,##0") & "</text>" &
    
    "</svg>"
RETURN SVG


// Mini Donut Chart
Mini Donut = 
VAR Value1 = [Category A Value]
VAR Value2 = [Category B Value]
VAR Value3 = [Category C Value]
VAR Total = Value1 + Value2 + Value3

VAR Pct1 = DIVIDE(Value1, Total)
VAR Pct2 = DIVIDE(Value2, Total)
VAR Pct3 = DIVIDE(Value3, Total)

VAR Size = 50
VAR Radius = 18
VAR Circumference = 2 * PI() * Radius
VAR Center = Size / 2

// Calculate dash arrays for each segment
VAR Dash1 = Pct1 * Circumference
VAR Dash2 = Pct2 * Circumference
VAR Dash3 = Pct3 * Circumference
VAR Gap = Circumference - Dash1

VAR Color1 = "%23118DFF"
VAR Color2 = "%2328A745"
VAR Color3 = "%23FFC107"

VAR SVG = 
    "data:image/svg+xml;utf8," &
    "<svg xmlns='http://www.w3.org/2000/svg' width='" & Size & "' height='" & Size & "'>" &
    
    // Segment 1
    "<circle cx='" & Center & "' cy='" & Center & "' r='" & Radius & "' " &
    "fill='none' stroke='" & Color1 & "' stroke-width='8' " &
    "stroke-dasharray='" & Dash1 & " " & Gap & "' " &
    "transform='rotate(-90 " & Center & " " & Center & ")'/>" &
    
    // Segment 2
    "<circle cx='" & Center & "' cy='" & Center & "' r='" & Radius & "' " &
    "fill='none' stroke='" & Color2 & "' stroke-width='8' " &
    "stroke-dasharray='" & Dash2 & " " & (Circumference - Dash2) & "' " &
    "stroke-dashoffset='" & (-Dash1) & "' " &
    "transform='rotate(-90 " & Center & " " & Center & ")'/>" &
    
    // Segment 3
    "<circle cx='" & Center & "' cy='" & Center & "' r='" & Radius & "' " &
    "fill='none' stroke='" & Color3 & "' stroke-width='8' " &
    "stroke-dasharray='" & Dash3 & " " & (Circumference - Dash3) & "' " &
    "stroke-dashoffset='" & (-Dash1 - Dash2) & "' " &
    "transform='rotate(-90 " & Center & " " & Center & ")'/>" &
    
    "</svg>"
RETURN SVG
